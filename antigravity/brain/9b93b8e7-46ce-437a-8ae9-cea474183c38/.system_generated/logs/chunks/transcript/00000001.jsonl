{"step_index":79,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-15T07:44:57Z","content":"Created At: 2026-11-15T12:44:57+05:00\nCompleted At: 2026-11-15T12:45:03+05:00\nFile Path: `file:///C:/Users/Surface%20PC/.gemini/downloader.py`\nTotal Lines: 71\nTotal Bytes: 2876\nShowing lines 1 to 71\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import os\r\n2: import requests\r\n3: import zipfile\r\n4: from bs4 import BeautifulSoup\r\n5: from concurrent.futures import ThreadPoolExecutor\r\n6: \r\n7: # ANIQ KITOB RO'YXATI TURGAN SAHIFA MANZILI\r\n8: url = \"https://ziyouz.com\"\r\n9: headers = {\"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36\"}\r\n10: \r\n11: print(\"[*] Ziyouz platformasi xavfsiz tizim orqali skaner qilinmoqda...\")\r\n12: response = requests.get(url, headers=headers)\r\n13: soup = BeautifulSoup(response.text, 'html.parser')\r\n14: \r\n15: # Barcha yuklab olish havolalarini qidirish\r\n16: links = soup.find_all('a')\r\n17: download_urls = []\r\n18: \r\n19: for link in links:\r\n20:     href = link.get('href', '')\r\n21:     # Ziyouz saytining ichki yuklash tizimi ssilkalarini ushlash\r\n22:     if \"com_jdownloads\" in href or \"download\" in href or href.endswith('.mp3') or href.endswith('.pdf'):\r\n23:         if not href.startswith('http'):\r\n24:             href = \"https://ziyouz.com\" + href\r\n25:         if href not in download_urls:\r\n26:             download_urls.append(href)\r\n27: \r\n28: print(f\"[+] Sahifada jami {len(download_urls)} ta kitob qismi aniqlandi.\")\r\n29: \r\n30: # Fayllarni yuklash funksiyasi\r\n31: def download_file(file_url):\r\n32:     try:\r\n33:         file_name = file_url.split('/')[-1].split('?')[0] or \"kitob_qismi.mp3\"\r\n34:         # Belgilarni tozalash\r\n35:         for char in ['?', '=', '&', '/', '\\\\', '*', ':', '\"', '<', '>', '|']:\r\n36:             file_name = file_name.replace(char, '_')\r\n37:             \r\n38:         if not (file_name.endswith('.mp3') or file_name.endswith('.pdf')):\r\n39:             file_name += \".mp3\"\r\n40:             \r\n41:         print(f\"[>] Yuklanmoqda: {file_name}\")\r\n42:         file_data = requests.get(file_url, headers=headers, timeout=15).content\r\n43:         with open(file_name, 'wb') as f:\r\n44:             f.write(file_data)\r\n45:         return file_name\r\n46:     except Exception as e:\r\n47:         print(f\"[X] Xatolik: {file_url} yuklanmadi. Sababi: {e}\")\r\n48:         return None\r\n49: \r\n50: # BIR VAQTNING O'ZIDA PARALLEL YUKLASH (KUNLAR KETMAYDI, 1 MINUTDA YUKLAYDI)\r\n51: print(\"[*] Ommaviy va parallel yuklash boshlandi. Iltimos kuting...\")\r\n52: downloaded_files = []\r\n53: with ThreadPoolExecutor(max_workers=5) as executor:\r\n54:     results = executor.map(download_file, download_urls)\r\n55:     for res in results:\r\n56:         if res:\r\n57:             downloaded_files.append(res)\r\n58: \r\n59: # HAMMASINI BITTA TAYYOR ZIP ARXIVGA JOYLASHTIRISH\r\n60: if downloaded_files:\r\n61:     zip_name = \"ommaviy_kitoblar.zip\"\r\n62:     print(f\"\\n[*] Yuklangan barcha {len(downloaded_files)} ta fayl {zip_name} arxiviga joylashtirilmoqda...\")\r\n63:     with zipfile.ZipFile(zip_name, 'w') as zipf:\r\n64:         for file in downloaded_files:\r\n65:             if os.path.exists(file):\r\n66:                 zipf.write(file)\r\n67:                 os.remove(file) # Kompyuter toza qolishi uchun vaqtincha fayllarni o'chiramiz\r\n68:     print(f\"[🎉] TAYYOR! Barcha kitoblar '{zip_name}' fayliga bittada yig'ildi!\")\r\n69: else:\r\n70:     print(\"[X] Hech qanday fayl yuklanmadi.\")\r\n71: \nThe above content shows the entire, complete file contents of the requested file.\n"}
