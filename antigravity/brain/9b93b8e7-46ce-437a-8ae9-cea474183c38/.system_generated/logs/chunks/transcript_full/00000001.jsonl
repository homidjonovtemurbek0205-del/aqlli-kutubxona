cha kitoblar mavjud emas.</p>';\n1135:         return;\n1136:       }\n1137: \n1138:       const isAdmin = currentUser && (currentUser.is_staff || currentUser.is_superuser);\n1139: \n1140:       books.forEach(book => {\n1141:         const fileUrl = book.file || '#';\n1142:         const deleteBtnHtml = isAdmin \n1143:           ? `<button class=\"btn-action btn-delete-admin\" onclick=\"deleteBook(${book.id}, '${book.title}')\" title=\"Kitobni o'chirish\"><i class=\"fa-solid fa-trash\"></i></button>` \n1144:           : '';\n1145: \n1146:         grid.innerHTML += `\n1147:           <div class=\"book-card\">\n1148:             <div>\n1149:               <h3 class=\"book-title\">${book.title}</h3>\n1150:               <div class=\"book-author\">Muallif: ${book.author}</div>\n1151:               <div class=\"book-genre\">${book.genre || 'PDF'}</div>\n1152:               <p class=\"book-desc\">${book.description || ''}</p>\n1153:             </div>\n1154:             \n1155:             <div class=\"book-actions\">\n1156:               <button class=\"btn-action btn-read-online\" onclick=\"openPdfModal('${book.title}', '${fileUrl}')\">\n1157:                 <i class=\"fa-solid fa-book-open\"></i> O'qish\n1158:               </button>\n1159:               <button class=\"btn-action btn-listen\" onclick=\"readAloud('${book.title}', '${book.description || ''}')\">\n1160:                 <i class=\"fa-solid fa-headphones-simple\"></i> Tinglash\n1161:               </button>\n1162:               ${deleteBtnHtml}\n1163:             </div>\n1164:           </div>\n1165:         `;\n1166:       });\n1167:     }\n1168: \n1169:     async function deleteBook(bookId, title) {\n1170:       if (!confirm(`\"${title}\" nomli kitobni o'chirishni tasdiqlaysizmi?`)) return;\n1171: \n1172:       const token = localStorage.getItem('access_token');\n1173:       try {\n1174:         const res = await fetch(`/api/books/${bookId}/`, {\n1175:           method: 'DELETE',\n1176:           headers: { 'Authorization': 'Bearer ' + token }\n1177:         });\n1178:         if (res.ok || res.status === 204) {\n1179:           alert('Kitob o\\'chirildi!');\n1180:           loadBooks();\n1181:         } else {\n1182:           alert('O\\'chirishda xatolik yuz berdi.');\n1183:         }\n1184:       } catch (err) {\n1185:         alert('Server bilan bog\\'lanishda xatolik.');\n1186:       }\n1187:     }\n1188: \n1189:     // UPLOAD HANDLERS\n1190:     const pdfInput = document.getElementById('pdfInput');\n1191:     if (pdfInput) {\n1192:       pdfInput.addEventListener('change', async (e) => {\n1193:         const file = e.target.files[0];\n1194:         if (!file) return;\n1195: \n1196:         const token = localStorage.getItem('access_token');\n1197:         const formData = new FormData();\n1198:         formData.append('pdffile', file);\n1199: \n1200:         try {\n1201:           const res = await fetch('/api/upload-pdf/', {\n1202:             method: 'POST',\n1203:             headers: { 'Authorization': 'Bearer ' + token },\n1204:             body: formData\n1205:           });\n1206:           if (res.ok) {\n1207:             alert('PDF Kitob yuklandi!');\n1208:             loadBooks();\n1209:           } else {\n1210:             alert('Yuklashda xatolik.');\n1211:           }\n1212:         } catch (err) {\n1213:           alert('Server xatoligi.');\n1214:         }\n1215:       });\n1216:     }\n1217: \n1218:     const zipInput = document.getElementById('zipInput');\n1219:     if (zipInput) {\n1220:       zipInput.addEventListener('change', async (e) => {\n1221:         const file = e.target.files[0];\n1222:         if (!file) return;\n1223: \n1224:         const token = localStorage.getItem('access_token');\n1225:         const formData = new FormData();\n1226:         formData.append('zipfile', file);\n1227: \n1228:         try {\n1229:           const res = await fetch('/api/upload-zip/', {\n1230:             method: 'POST',\n1231:             headers: { 'Authorization': 'Bearer ' + token },\n1232:             body: formData\n1233:           });\n1234:           const data = await res.json();\n1235:           if (res.ok) {\n1236:             alert(data.message || 'ZIP Arxiv yuklandi!');\n1237:             loadBooks();\n1238:           } else {\n1239:             alert('ZIP arxivni yuklashda xatolik.');\n1240:           }\n1241:         } catch (err) {\n1242:           alert('Server xatoligi.');\n1243:         }\n1244:       });\n1245:     }\n1246: \n1247:     // PDF MODAL OPENER\n1248:     function openPdfModal(title, url) {\n1249:       document.getElementById('pdfModalTitle').innerText = title;\n1250:       document.getElementById('pdfFrame').src = url;\n1251:       document.getElementById('pdfModal').style.display = 'flex';\n1252:     }\n1253: \n1254:     function closePdfModal() {\n1255:       document.getElementById('pdfModal').style.display = 'none';\n1256:       document.getElementById('pdfFrame').src = '';\n1257:     }\n1258: \n1259:     // CHATBOT MESSAGING\n1260:     function handleKeyPress(event) {\n1261:       if (event.key === 'Enter') sendMessage();\n1262:     }\n1263: \n1264:     async function sendChatMessage() {\n1265:       const input = document.getElementById('chat-input');\n1266:       const message = input.value.trim();\n1267:       if (!message) return;\n1268: \n1269:       const token = localStorage.getItem('access_token');\n1270:       const msgArea = document.getElementById('chat-messages');\n1271:       msgArea.innerHTML += `<div style=\"background:#8b5cf6; color:#fff; padding:8px 12px; border-radius:12px 12px 0 12px; align-self:flex-end; max-width:80%;\">${message}</div>`;\n1272:       input.value = '';\n1273:       msgArea.scrollTop = msgArea.scrollHeight;\n1274: \n1275:       try {\n1276:         const res = await fetch('/api/chat/', {\n1277:           method: 'POST',\n1278:           headers: {\n1279:             'Content-Type': 'application/json',\n1280:             'Authorization': 'Bearer ' + token\n1281:           },\n1282:           body: JSON.stringify({ message: message })\n1283:         });\n1284:         const data = await res.json();\n1285:         const reply = (data.reply || 'Javob olindi.').replace(/\\n/g, '<br>');\n1286:         msgArea.innerHTML += `<div style=\"background:#232335; padding:8px 12px; border-radius:12px 12px 12px 0; align-self:flex-start; max-width:80%; margin-top:5px;\">${reply}</div>`;\n1287:         msgArea.scrollTop = msgArea.scrollHeight;\n1288:       } catch (err) {\n1289:         msgArea.innerHTML += `<div style=\"background:#ef4444; color:#fff; padding:8px 12px; border-radius:12px; align-self:flex-start;\">Server bilan bog'lanishda xatolik.</div>`;\n1290:       }\n1291:     }\n1292: \n1293:     checkAuth();\n1294:   </script>\n1295: </body>\n1296: </html>\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
