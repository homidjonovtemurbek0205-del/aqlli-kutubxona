{"step_index":203,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-15T11:20:10Z","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"# -*- coding: utf-8 -*-\n\"\"\"\nAqlli Kutubxona Sayti (Smart Library with AI & Audiobooks)\nLoyihani sozlovchi va ishga tushiruvchi skript.\n\nUshbu skript:\n1. Zaruriy Python kutubxonalarini o'rnatadi.\n2. Django ma'lumotlar bazasini sozlaydi va mavjud kitoblarni indekslaydi.\n3. Serverni ishga tushiradi (http://127.0.0.1:8000/).\n\"\"\"\n\nimport os\nimport sys\nimport subprocess\n\ndef install_dependencies():\n    \"\"\"Zaruriy kutubxonalarni o'rnatish\"\"\"\n    print(\"\\n1. Kutubxonalarni tekshirish va o'rnatish...\")\n    requirements_file = 'requirements.txt'\n    if os.path.exists(requirements_file):\n        try:\n            subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-r\", requirements_file], check=True)\n            print(\" - [MUVAFFAQIYATLI] Kutubxonalar tayyor.\")\n        except Exception as e:\n            print(f\" - [OGOHLANTIRISH] pip install muammo: {e}\")\n\ndef setup_database():\n    \"\"\"Ma'lumotlar bazasini sozlash (Django SQLite)\"\"\"\n    print(\"\\n2. Ma'lumotlar bazasini sozlash (Django Migrations)...\")\n    try:\n        subprocess.run([sys.executable, \"manage.py\", \"migrate\"], check=True)\n        print(\" - [MUVAFFAQIYATLI] Migratsiyalar bajarildi.\")\n    except Exception as e:\n        print(f\" - [XATOLIK] Migratsiyada xatolik: {e}\")\n        sys.exit(1)\n\n    print(\"\\n3. Boshlang'ich foydalanuvchilar va kitoblarni indekslash...\")\n    try:\n        subprocess.run([sys.executable, \"manage.py\", \"setup_library\"], check=True)\n        print(\" - [MUVAFFAQIYATLI] Admin va kitoblar fondi sozlandi.\")\n    except Exception as e:\n        print(f\" - [OGOHLANTIRISH] setup_library: {e}\")\n\ndef run_server():\n    \"\"\"Django serverini ishga tushirish\"\"\"\n    print(\"\\n4. Server ishga tushirilmoqda...\")\n    print(\"=\" * 60)\n    print(\"  AQLLI KUTUBXONA TIZIMI TAYYOR!\")\n    print(\"  --> http://127.0.0.1:8000/\")\n    print(\"  Admin hisobi:  admin@library.com  |  Parol: admin123\")\n    print(\"  Kitobxon:      user@library.com   |  Parol: user123\")\n    print(\"=\" * 60)\n    print(\"Serverni to'xtatish uchun CTRL + C tugmalarini bosing.\\n\")\n\n    try:\n        subprocess.run([sys.executable, \"manage.py\", \"runserver\", \"127.0.0.1:8000\"])\n    except KeyboardInterrupt:\n        print(\"\\nServer to'xtatildi.\")\n\nif __name__ == '__main__':\n    print(\"=\" * 60)\n    print(\"  AQLLI KUTUBXONA TIZIMI - ISHGA TUSHIRISH\")\n    print(\"=\" * 60)\n    install_dependencies()\n    setup_database()\n    run_server()\n","Description":"Update run_project.py to run Django migrations, setup_library, and start server","Overwrite":true,"TargetFile":"C:\\Users\\Surface PC\\.gemini\\run_project.py","toolAction":"Updating run_project.py","toolSummary":"Update run_project.py"}}]}
{"step_index":206,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-15T11:20:26Z","content":"Created At: 2026-11-15T16:20:26+05:00\nCompleted At: 2026-11-15T16:20:26+05:00\nFile Path: `file:///C:/Users/Surface%20PC/.gemini/core/tests.py`\nTotal Lines: 115\nTotal Bytes: 4706\nShowing lines 1 to 115\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import os\n2: import io\n3: import zipfile\n4: import pymupdf\n5: \n6: from django.test import TestCase\n7: from django.core.files.uploadedfile import SimpleUploadedFile\n8: from django.contrib.auth import get_user_model\n9: from rest_framework.test import APIClient\n10: \n11: from core.models import Book\n12: from core.views import extract_pdf_content\n13: \n14: User = get_user_model()\n15: \n16: \n17: def create_sample_pdf_bytes(text=\"Aqlli Kutubxona PDF Test Matni\"):\n18:     doc = pymupdf.open()\n19:     page = doc.new_page()\n20:     page.insert_text((50, 50), text)\n21:     pdf_bytes = doc.tobytes()\n22:     doc.close()\n23:     return pdf_bytes\n24: \n25: \n26: class PDFExtractionAndLibraryTests(TestCase):\n27: \n28:     def setUp(self):\n29:         self.client = APIClient()\n30:         self.admin = User.objects.create_superuser(\n31:             email='admin@library.com',\n32:             password='adminpassword123',\n33:             username='adminuser'\n34:         )\n35:         self.regular_user = User.objects.create_user(\n36:             email='user@library.com',\n37:             password='userpassword123',\n38:             username='regularuser'\n39:         )\n40: \n41:     def test_pdf_text_extraction(self):\n42:         \"\"\"PDF fayldan matn to'g'ri o'qib olinishini tekshirish\"\"\"\n43:         sample_text = \"O'zbekiston Milliy Kutubxonasi Elektron Nusxa\"\n44:         pdf_bytes = create_sample_pdf_bytes(sample_text)\n45:         \n46:         extracted_text, toc = extract_pdf_content(pdf_bytes)\n47:         self.assertIn(sample_text, extracted_text)\n48: \n49:     def test_admin_upload_pdf_and_context(self):\n50:         \"\"\"Admin tarafidan PDF yuklanganda baza va faylda saqlanishini hamda text extract bo'lishini tekshirish\"\"\"\n51:         self.client.force_authenticate(user=self.admin)\n52:         \n53:         sample_text = \"Alisher Navoiy Xamsa asari matni\"\n54:         pdf_bytes = create_sample_pdf_bytes(sample_text)\n55:         pdf_file = SimpleUploadedFile(\"xamsa.pdf\", pdf_bytes, content_type=\"application/pdf\")\n56: \n57:         response = self.client.post('/api/upload-pdf/', {'pdffile': pdf_file}, format='multipart')\n58:         self.assertEqual(response.status_code, 201)\n59: \n60:         book = Book.objects.get(title=\"xamsa\")\n61:         self.assertIn(\"Alisher Navoiy\", book.content)\n62:         self.assertIsNotNone(book.file)\n63: \n64:     def test_regular_user_upload_forbidden(self):\n65:         \"\"\"Oddiy foydalanuvchi PDF yuklay olmasligini (403 Forbidden) tekshirish\"\"\"\n66:         self.client.force_authenticate(user=self.regular_user)\n67:         pdf_bytes = create_sample_pdf_bytes(\"Sinov\")\n68:         pdf_file = SimpleUploadedFile(\"test.pdf\", pdf_bytes, content_type=\"application/pdf\")\n69: \n70:         response = self.client.post('/api/upload-pdf/', {'pdffile': pdf_file}, format='multipart')\n71:         self.assertEqual(response.status_code, 403)\n72: \n73:     def test_admin_upload_zip(self):\n74:         \"\"\"ZIP arxiv ichidagi PDF fayllar to'liq chiqarib olinishini tekshirish\"\"\"\n75:         self.client.force_authenticate(user=self.admin)\n76:         \n77:         pdf_bytes = create_sample_pdf_bytes(\"ZIP Arxiv Ichidagi Kitob\")\n78:         zip_buffer = io.BytesIO()\n79:         with zipfile.ZipFile(zip_buffer, 'w', zipfile.ZIP_DEFLATED) as zf:\n80:             zf.writestr(\"book_inside.pdf\", pdf_bytes)\n81:         zip_buffer.seek(0)\n82: \n83:         zip_file = SimpleUploadedFile(\"books.zip\", zip_buffer.read(), content_type=\"application/zip\")\n84:         response = self.client.post('/api/upload-zip/', {'zipfile': zip_file}, format='multipart')\n85:         self.assertEqual(response.status_code, 201)\n86:         self.assertTrue(Book.objects.filter(title=\"book_inside\").exists())\n87: \n88:     def test_ai_chat_with_extracted_content(self):\n89:         \"\"\"AI Chatbot view matnlarni xatosiz qayta ishlashini tekshirish\"\"\"\n90:         self.client.force_authenticate(user=self.regular_user)\n91:         Book.objects.create(\n92:             title=\"O'tkan kunlar\",\n93:             author=\"Abdulla Qodiriy\",\n94:             content=\"Otabek va Kumush sevgi qissasi.\"\n95:         )\n96: \n97:         response = self.client.post('/api/chat/', {'message': \"O'tkan kunlar haqida aytib ber\"}, format='json')\n98:         self.assertEqual(response.status_code, 200)\n99:         self.assertIn(\"reply\", response.data)\n100: \n101:     def test_book_deletion_permissions(self):\n102:         \"\"\"Admin kitobni o'chira olishi, oddiy foydalanuvchi esa o'chira olmasligini tekshirish\"\"\"\n103:         book = Book.objects.create(title=\"Vaqt va Inson\", author=\"Tohir Malik\")\n104: \n105:         # Oddiy foydalanuvchi o'chirishga urinsa: 403 Forbidden\n106:         self.client.force_authenticate(user=self.regular_user)\n107:         res_user = self.client.delete(f'/api/books/{book.id}/')\n108:         self.assertEqual(res_user.status_code, 403)\n109: \n110:         # Admin o'chirishga urinsa: 204 No Content\n111:         self.client.force_authenticate(user=self.admin)\n112:         res_admin = self.client.delete(f'/api/books/{book.id}/')\n113:         self.assertEqual(res_admin.status_code, 204)\n114:         self.assertFalse(Book.objects.filter(id=book.id).exists())\n115: \nThe above content shows the entire, complete file contents of the requested file.\n"}
