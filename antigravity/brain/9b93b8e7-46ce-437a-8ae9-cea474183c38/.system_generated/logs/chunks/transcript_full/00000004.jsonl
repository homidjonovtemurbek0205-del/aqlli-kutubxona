\n      }\n\n      grid.innerHTML = filtered.map(book => {\n        const hasAudio = Boolean(book.has_audio || book.audio_file || book.audiobook_url);\n        const hasPdf = Boolean(book.file);\n        const audioUrl = book.audio_file || book.audiobook_url || '';\n        const pdfUrl = book.file || '';\n\n        const audioBadge = hasAudio \n          ? `<span class=\"badge-tag audio\"><i class=\"fa-solid fa-volume-high\"></i> Audio</span>` \n          : '';\n        const pdfBadge = hasPdf \n          ? `<span class=\"badge-tag pdf\"><i class=\"fa-solid fa-file-pdf\"></i> PDF</span>` \n          : '';\n\n        // Admin action buttons (strictly for admin only)\n        const adminButtons = isAdmin ? `\n          <button class=\"btn-admin-action btn-add-audio-admin\" title=\"Audio kitob biriktirish\" onclick=\"openUploadAudioModal(${book.id}, '${escapeHtml(book.title)}')\">\n            <i class=\"fa-solid fa-file-audio\"></i>\n          </button>\n          <button class=\"btn-admin-action btn-delete-admin\" title=\"Kitobni o'chirish\" onclick=\"deleteBook(${book.id}, '${escapeHtml(book.title)}')\">\n            <i class=\"fa-solid fa-trash-can\"></i>\n          </button>\n        ` : '';\n\n        return `\n          <div class=\"book-card\" id=\"bookCard-${book.id}\">\n            <div class=\"book-card-banner\">\n              <div class=\"book-icon-badge\">\n                <i class=\"fa-solid fa-book-bookmark\"></i>\n              </div>\n              <div class=\"book-card-badges\">\n                ${audioBadge}\n                ${pdfBadge}\n              </div>\n            </div>\n            \n            <div class=\"book-card-body\">\n              <h3 class=\"book-title\" title=\"${escapeHtml(book.title)}\">${escapeHtml(book.title)}</h3>\n              <div class=\"book-author\">\n                <i class=\"fa-solid fa-feather-pointed\" style=\"color:var(--primary);\"></i>\n                <span>${escapeHtml(book.author || 'Noma\\'lum')}</span>\n              </div>\n              <div class=\"book-genre-label\">${escapeHtml(book.genre || 'Adabiyot')}</div>\n              <p class=\"book-desc\">${escapeHtml(book.description || 'Ushbu kitob tavsifi tez orada to\\'ldiriladi.')}</p>\n\n              <div class=\"book-card-actions\">\n                <button class=\"btn-card btn-read\" onclick=\"openReaderModal(${book.id})\">\n                  <i class=\"fa-solid fa-book-open\"></i> O'qish\n                </button>\n                <button class=\"btn-card btn-listen\" onclick=\"handleBookListen(${book.id})\">\n                  <i class=\"fa-solid fa-headphones\"></i> Tinglash\n                </button>\n                ${adminButtons}\n              </div>\n            </div>\n          </div>\n        `;\n      }).join('');\n    }\n\n    function escapeHtml(text) {\n      if (!text) return '';\n      return text.replace(/[&<>\"']/g, function(m) {\n        return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[m];\n      });\n    }\n\n    // AUDIO PLAYER LOGIC\n    function handleBookListen(bookId) {\n      const book = allBooks.find(b => b.id === bookId);\n      if (!book) return;\n\n      const audioUrl = book.audio_file || book.audiobook_url;\n      if (audioUrl) {\n        startAudioPlayback(book, audioUrl);\n      } else {\n        // Fallback: browser text-to-speech\n        showToast(`\"${book.title}\" audio fayli mavjud emas. Matn ovozli o'qilmoqda...`, 'info');\n        speakText(`${book.title}. Muallif: ${book.author}. ${book.description || ''}`);\n      }\n    }\n\n    function startAudioPlayback(book, audioUrl) {\n      if (window.speechSynthesis && window.speechSynthesis.speaking) {\n        window.speechSynthesis.cancel();\n      }\n\n      document.getElementById('playerBookTitle').innerText = book.title;\n      document.getElementById('playerBookAuthor').innerText = book.author || 'Audio Kitob';\n      document.getElementById('audioPlayerBar').style.display = 'flex';\n\n      nativeAudio.src = audioUrl;\n      nativeAudio.playbackRate = currentPlaybackRate;\n      nativeAudio.play().then(() => {\n        updatePlayPauseButton(true);\n      }).catch(err => {\n        console.warn(\"Autoplay blocked or stream error:\", err);\n        updatePlayPauseButton(false);\n      });\n    }\n\n    function setupAudioPlayerEvents() {\n      nativeAudio.addEventListener('timeupdate', () => {\n        const cur = nativeAudio.currentTime;\n        const dur = nativeAudio.duration;\n        document.getElementById('playerCurrentTime').innerText = formatTime(cur);\n        if (dur && !isNaN(dur)) {\n          document.getElementById('playerDuration').innerText = formatTime(dur);\n          const pct = (cur / dur) * 100;\n          document.getElementById('playerProgressFilled').style.width = pct + '%';\n        }\n      });\n\n      nativeAudio.addEventListener('ended', () => {\n        updatePlayPauseButton(false);\n        document.getElementById('playerProgressFilled').style.width = '0%';\n      });\n\n      nativeAudio.addEventListener('pause', () => updatePlayPauseButton(false));\n      nativeAudio.addEventListener('play', () => updatePlayPauseButton(true));\n    }\n\n    function togglePlayPause() {\n      if (nativeAudio.paused) {\n        nativeAudio.play();\n      } else {\n        nativeAudio.pause();\n      }\n    }\n\n    function updatePlayPauseButton(isPlaying) {\n      const icon = document.getElementById('playPauseIcon');\n      if (isPlaying) {\n        icon.className = 'fa-solid fa-pause';\n      } else {\n        icon.className = 'fa-solid fa-play';\n      }\n    }\n\n    function seekAudio(seconds) {\n      nativeAudio.currentTime = Math.max(0, Math.min(nativeAudio.duration || 0, nativeAudio.currentTime + seconds));\n    }\n\n    function handleSeekbarClick(e) {\n      const bar = document.getElementById('playerProgressBar');\n      const rect = bar.getBoundingClientRect();\n      const clickX = e.clientX - rect.left;\n      const width = rect.width;\n      if (nativeAudio.duration) {\n        nativeAudio.currentTime = (clickX / width) * nativeAudio.duration;\n      }\n    }\n\n    function cyclePlaybackRate() {\n      const curIdx = playbackRates.indexOf(currentPlaybackRate);\n      const nextIdx = (curIdx + 1) % playbackRates.length;\n      currentPlaybackRate = playbackRates[nextIdx];\n      nativeAudio.playbackRate = currentPlaybackRate;\n      document.getElementById('btnPlaybackRate').innerText = currentPlaybackRate + 'x';\n    }\n\n    function setVolume(val) {\n      nativeAudio.volume = parseFloat(val);\n      const icon = document.getElementById('playerVolumeIcon');\n      if (nativeAudio.volume === 0) icon.className = 'fa-solid fa-volume-xmark';\n      else if (nativeAudio.volume < 0.5) icon.className = 'fa-solid fa-volume-low';\n      else icon.className = 'fa-solid fa-volume-high';\n    }\n\n    function toggleMute() {\n      nativeAudio.muted = !nativeAudio.muted;\n      document.getElementById('playerVolumeIcon').className = nativeAudio.muted \n        ? 'fa-solid fa-volume-xmark' \n        : 'fa-solid fa-volume-high';\n    }\n\n    function closeAudioPlayer() {\n      nativeAudio.pause();\n      nativeAudio.src = '';\n      document.getElementById('audioPlayerBar').style.display = 'none';\n    }\n\n    function formatTime(sec) {\n      if (!sec || isNaN(sec)) return '00:00';\n      const m = Math.floor(sec / 60);\n      const s = Math.floor(sec % 60);\n      return (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s);\n    }\n\n    function speakText(text) {\n      if (window.speechSynthesis) {\n        if (window.speechSynthesis.speaking) window.speechSynthesis.cancel();\n        const utter = new SpeechSynthesisUtterance(text);\n        utter.lang = 'uz-UZ';\n        utter.rate = 0.95;\n        window.speechSynthesis.speak(utter);\n      }\n    }\n\n    // READER MODAL\n    function openReaderModal(bookId) {\n      const book = allBooks.find(b => b.id === bookId);\n      if (!book) return;\n\n      document.getElementById('readerBookTitle').innerText = book.title;\n      const frame = document.getElementById('readerPdfFrame');\n      const textContainer = document.getElementById('readerTextContainer');\n\n      if (book.file) {\n        frame.src = book.file;\n        switchReaderTab('pdf');\n      } else {\n        switchReaderTab('text');\n      }\n\n      textContainer.innerText = book.content || (book.description || \"Ushbu kitobning matnli varianti hozircha mavjud emas.\");\n      document.getElementById('readerModal').style.display = 'flex';\n    }\n\n    function switchReaderTab(tab) {\n      const btnPdf = document.getElementById('btnTabPdf');\n      const btnText = document.getElementById('btnTabText');\n      const frame = document.getElementById('readerPdfFrame');\n      const text = document.getElementById('readerTextContainer');\n\n      if (tab === 'pdf') {\n        btnPdf.classList.add('active');\n        btnText.classList.remove('active');\n        frame.style.display = 'block';\n        text.style.display = 'none';\n      } else {\n        btnText.classList.add('active');\n        btnPdf.classList.remove('active');\n        frame.style.display = 'none';\n        text.style.display = 'block';\n      }\n    }\n\n    function closeReaderModal() {\n      document.getElementById('readerModal').style.display = 'none';\n      document.getElementById('readerPdfFrame').src = '';\n    }\n\n    // ADMIN: ADD BOOK MODAL\n    function openAddBookModal() {\n      document.getElementById('formAddBook').reset();\n      document.getElementById('addBookModal').style.display = 'flex';\n    }\n\n    function closeAddBookModal() {\n      document.getElementById('addBookModal').style.display = 'none';\n    }\n\n    async function handleAddBookSubmit(e) {\n      e.preventDefault();\n      const token = localStorage.getItem('access_token');\n      if (!token) {\n        showToast(\"Faqat administrator kitob qo'sha oladi. Iltimos kiring.\", 'error');\n        return;\n      }\n\n      const title = document.getElementById('newBookTitle').value.trim();\n      const author = document.getElementById('newBookAuthor').value.trim() || \"Noma'lum\";\n      const genre = document.getElementById('newBookGenre').value.trim() || \"Badiiy\";\n      const description = document.getElementById('newBookDesc').value.trim();\n      const pdfFile = document.getElementById('newBookPdf').files[0];\n      const audioFile = document.getElementById('newBookAudio').files[0];\n      const audioUrl = document.getElementById('newBookAudioUrl').value.trim();\n\n      const formData = new FormData();\n      formData.append('title', title);\n      formData.append('author', author);\n      formData.append('genre', genre);\n      formData.append('description', description);\n      if (pdfFile) formData.append('file', pdfFile);\n      if (audioFile) formData.append('audio_file', audioFile);\n      if (audioUrl) formData.append('audiobook_url', audioUrl);\n\n      const btn = document.getElementById('btnSaveBook');\n      btn.disabled = true;\n      btn.innerText = \"Yuklanmoqda...\";\n\n      try {\n        const res = await fetch('/api/books/', {\n          method: 'POST',\n          headers: { 'Authorization': 'Bearer ' + token },\n          body: formData\n        });\n        if (res.ok) {\n          showToast(`\"${title}\" kitobi muvaffaqiyatli qo'shildi!`, 'success');\n          closeAddBookModal();\n          await loadBooks();\n        } else {\n          const data = await res.json();\n          showToast(data.detail || \"Kitob qo'shishda xatolik yuz berdi.\", 'error');\n        }\n      } catch (err) {\n        showToast(\"Server xatosi.\", 'error');\n      } finally {\n        btn.disabled = false;\n        btn.innerText = \"Kitobni Saqlash\";\n      }\n    }\n\n    // ADMIN: UPLOAD AUDIO TO EXISTING BOOK\n    function openUploadAudioModal(bookId, bookTitle) {\n      document.getElementById('audioTargetBookId').value = bookId;\n      document.getElementById('audioTargetBookTitle').innerText = bookTitle;\n      document.getElementById('formUploadAudio').reset();\n      document.getElementById('uploadAudioModal').style.display = 'flex';\n    }\n\n    function closeUploadAudioModal() {\n      document.getElementById('uploadAudioModal').style.display = 'none';\n    }\n\n    async function handleAudioUploadSubmit(e) {\n      e.preventDefault();\n      const token = localStorage.getItem('access_token');\n      const bookId = document.getElementById('audioTargetBookId').value;\n      const audioFile = document.getElementById('audioUploadFile').files[0];\n      const audioUrl = document.getElementById('audioUploadUrl').value.trim();\n\n      if (!audioFile && !audioUrl) {\n        showToast(\"Iltimos, audio fayl tanlang yoki havola kiriting.\", 'error');\n        return;\n      }\n\n      const formData = new FormData();\n      if (audioFile) formData.append('audio_file', audioFile);\n      if (audioUrl) formData.append('audiobook_url', audioUrl);\n\n      const btn = document.getElementById('btnSaveAudio');\n      btn.disabled = true;\n      btn.innerText = \"Yuklanmoqda...\";\n\n      try {\n        const res = await fetch(`/api/books/${bookId}/upload_audio/`, {\n          method: 'POST',\n          headers: { 'Authorization': 'Bearer ' + token },\n          body: formData\n        });\n        if (res.ok) {\n          showToast(\"Audio kitob muvaffaqiyatli biriktirildi!\", 'success');\n          closeUploadAudioModal();\n          await loadBooks();\n        } else {\n          const data = await res.json();\n          showToast(data.detail || data.non_field_errors?.[0] || \"Yuklashda xatolik yuz berdi.\", 'error');\n        }\n      } catch (err) {\n        showToast(\"Server bilan bog'lanishda xatolik.\", 'error');\n      } finally {\n        btn.disabled = false;\n        btn.innerText = \"Audio Kitobni Saqlash\";\n      }\n    }\n\n    // ADMIN: DELETE BOOK\n    async function deleteBook(bookId, title) {\n      if (!confirm(`\"${title}\" nomli kitobni o'chirishni tasdiqlaysizmi?\\nBu amalni qaytarib bo'lmaydi!`)) {\n        return;\n      }\n\n      const token = localStorage.getItem('access_token');\n      try {\n        const res = await fetch(`/api/books/${bookId}/`, {\n          method: 'DELETE',\n          headers: { 'Authorization': 'Bearer ' + token }\n        });\n        if (res.status === 204 || res.ok) {\n          showToast(`\"${title}\" kitobi o'chirildi!`, 'success');\n          await loadBooks();\n        } else if (res.status === 403) {\n          showToast(\"Faqat administrator kitobni o'chirish huquqiga ega!\", 'error');\n        } else {\n          showToast(\"O'chirishda xatolik yuz berdi.\", 'error');\n        }\n      } catch (err) {\n        showToast(\"Server bilan bog'lanishda xatolik.\", 'error');\n      }\n    }\n\n    // ADMIN: QUICK PDF / ZIP UPLOADS\n    async function handleQuickUpload(input, type) {\n      const file = input.files[0];\n      if (!file) return;\n\n      const token = localStorage.getItem('access_token');\n      if (!token) {\n        showToast(\"Faqat admin yuklay oladi.\", 'error');\n        return;\n      }\n\n      const formData = new FormData();\n      const endpoint = type === 'pdf' ? '/api/upload-pdf/' : '/api/upload-zip/';\n      const field = type === 'pdf' ? 'pdffile' : 'zipfile';\n      formData.append(field, file);\n\n      showToast(`${file.name} yuklanmoqda va qayta ishlanmoqda...`, 'info');\n\n      try {\n        const res = await fetch(endpoint, {\n          method: 'POST',\n          headers: { 'Authorization': 'Bearer ' + token },\n          body: formData\n        });\n        const data = await res.json();\n        if (res.ok) {\n          showToast(data.message || `Fayl muvaffaqiyatli yuklandi va kitoblar qo'shildi!`, 'success');\n          await loadBooks();\n        } else {\n          showToast(data.detail || \"Yuklashda xatolik.\", 'error');\n        }\n      } catch (err) {\n        showToast(\"Server xatosi.\", 'error');\n      } finally {\n        input.value = '';\n      }\n    }\n\n    // AI CHATBOT FUNCTIONALITY\n    function toggleChat() {\n      const win = document.getElementById('chatWindow');\n      win.classList.toggle('active');\n      if (win.classList.contains('active')) {\n        document.getElementById('chatInput').focus();\n      }\n    }\n\n    function handleChatKeyPress(e) {\n      if (e.key === 'Enter') {\n        sendMessage();\n      }\n    }\n\n    function askQuickPrompt(text) {\n      document.getElementById('chatInput').value = text;\n      sendMessage();\n    }\n\n    async function sendMessage() {\n      const input = document.getElementById('chatInput');\n      const message = input.value.trim();\n      if (!message) return;\n\n      const chatMessages = document.getElementById('chatMessages');\n\n      // Add user message bubble\n      const userBubble = document.createElement('div');\n      userBubble.className = 'chat-bubble user';\n      userBubble.innerText = message;\n      chatMessages.appendChild(userBubble);\n      input.value = '';\n\n      // Add loading bot bubble\n      const loadingBubble = document.createElement('div');\n      loadingBubble.className = 'chat-bubble bot';\n      loadingBubble.id = 'botLoadingBubble';\n      loadingBubble.innerHTML = '<i class=\"fa-solid fa-ellipsis fa-fade\"></i> AI o\\'ylamoqda...';\n      chatMessages.appendChild(loadingBubble);\n      chatMessages.scrollTop = chatMessages.scrollHeight;\n\n      const token = localStorage.getItem('access_token');\n      const headers = { 'Content-Type': 'application/json' };\n      if (token) headers['Authorization'] = 'Bearer ' + token;\n\n      try {\n        const res = await fetch('/api/chat/', {\n          method: 'POST',\n          headers: headers,\n          body: JSON.stringify({ message: message })\n        });\n        const data = await res.json();\n        \n        loadingBubble.id = '';\n        if (res.ok && data.reply) {\n          // Format markdown bold & linebreaks\n          let formattedReply = escapeHtml(data.reply)\n            .replace(/\\*\\*(.*?)\\*\\*/g, '<b>$1</b>')\n            .replace(/\\n/g, '<br>');\n          loadingBubble.innerHTML = formattedReply;\n        } else {\n          loadingBubble.innerHTML = \"Kechirasiz, javob olishda xatolik yuz berdi.\";\n        }\n      } catch (err) {\n        loadingBubble.id = '';\n        loadingBubble.innerHTML = \"Server bilan bog'lanishda xatolik yuz berdi.\";\n      }\n\n      chatMessages.scrollTop = chatMessages.scrollHeight;\n    }\n  </script>\n</body>\n</html>\n","Description":"Complete modern frontend with audio player, admin book/audio permissions, fixed AI chat, and responsive dark glass design","Overwrite":true,"TargetFile":"C:\\Users\\Surface PC\\.gemini\\core\\templates\\core\\index.html","toolAction":"Writing modern frontend template","toolSummary":"Write modern core/templates/core/index.html"}}]}
